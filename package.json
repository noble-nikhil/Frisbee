{
  "name": "frisbee",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @frisbee/web dev",
    "dev:server": "pnpm --filter @frisbee/server dev",
    "build": "pnpm --filter @frisbee/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --config eslint.config.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "test": "pnpm -r --if-present test",
    "emulators": "firebase emulators:start --only auth,firestore --import .emulator-data --export-on-exit",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config tests/rules/vitest.config.ts\"",
    "seed:emulator": "pnpm --filter @frisbee/server seed:emulator",
    "seed": "pnpm --filter @frisbee/server seed",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@firebase/util",
      "protobufjs"
    ]
  }
}
