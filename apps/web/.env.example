# Copy to apps/web/.env.local for local dev. On Vercel, add the same names under
# Project → Settings → Environment Variables (no quotes, no trailing spaces).

# Firebase web config — public identifiers, not secrets (security = rules + claims).
# Firebase console → Project settings → General → Your apps → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary — unsigned uploads straight from the browser.
# Cloud name: Cloudinary console → Settings → API keys (top of page). NOT the API key/secret.
# Preset: Settings → Upload → Upload presets → Add, Signing mode = Unsigned, name it exactly this.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=frisbee_unsigned

# Node service origin (Render). Leave empty locally — the Vite dev server proxies /api to :8787.
# On Vercel: https://<your-service>.onrender.com   (no trailing slash)
VITE_API_URL=

VITE_COLLEGE_DOMAIN=srmap.edu.in
# true = talk to the local emulators (pnpm emulators). Must be false on Vercel.
VITE_USE_EMULATORS=false
