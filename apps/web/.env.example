# Firebase web config — these are public identifiers, not secrets (security = rules + claims)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary — unsigned uploads from the browser (cloud name + preset only; never the API secret)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=frisbee_unsigned

VITE_COLLEGE_DOMAIN=srmap.edu.in
VITE_USE_EMULATORS=false
