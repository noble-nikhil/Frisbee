# Copy to apps/server/.env (never commit the real file).
PORT=8787
# Comma-separated browser origins allowed to call this service.
ALLOWED_ORIGINS=http://localhost:5173
COLLEGE_DOMAIN=srmap.edu.in

# Firebase Admin credentials — one of the two:
#   1) base64 of the service-account JSON (easiest on Render):  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=
#   2) path to the JSON file (local dev)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=frisbee-9fcfb

# Cloudinary (server side only — the API secret must never reach the browser)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret for the cron endpoint (any external cron pinger sends it as ?key=)
CRON_KEY=change-me
