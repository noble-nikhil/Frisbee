{
  "name": "@frisbee/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:emulator": "node scripts/with-emulators.mjs tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "seed:emulator": "node scripts/with-emulators.mjs tsx scripts/seed.ts",
    "encode-service-account": "node scripts/encode-service-account.mjs"
  },
  "dependencies": {
    "@frisbee/shared": "workspace:*",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "^13.7.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "typescript": "~5.9.3"
  }
}
